{
  "name": "gui-git-history",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.6",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "watch": "pnpm dev",
    "dev:shared": "pnpm --filter @gui-git-history/shared dev",
    "dev:extension": "pnpm --filter vscode-extension-guigit dev",
    "dev:webview": "pnpm --filter @gui-git-history/webview dev",
    "rpc:generate": "pnpm --filter @gui-git-history/shared build && node scripts/generate-rpc-contract.mjs",
    "rpc:check": "pnpm --filter @gui-git-history/shared build && node scripts/generate-rpc-contract.mjs --check",
    "typecheck": "pnpm rpc:check && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm rpc:check && pnpm -r test",
    "build": "pnpm rpc:check && pnpm -r build",
    "package": "pnpm build && pnpm --filter vscode-extension-guigit package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
