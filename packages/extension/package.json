{
  "name": "vscode-extension-guigit",
  "displayName": "GUI Git History",
  "description": "A visual Git history viewer with advanced commit operations",
  "version": "0.1.24",
  "publisher": "Mickls",
  "license": "MIT",
  "icon": "assets/gui-git-history-high-resolution-logo-transparent.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mickls/vscode-extension-guigit.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension/activate.js",
  "activationEvents": [
    "onCommand:guigit.showHistory",
    "onView:guigit.historyView",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "guigit-log",
        "aliases": [
          "GUI Git History Log"
        ],
        "extensions": [
          ".guigit-log"
        ]
      }
    ],
    "grammars": [
      {
        "language": "guigit-log",
        "scopeName": "source.guigit-log",
        "path": "./syntaxes/guigit-log.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "GUI Git History",
      "properties": {
        "guigit.proxy.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable custom proxy configuration"
        },
        "guigit.proxy.http": {
          "type": "string",
          "default": "",
          "description": "HTTP proxy URL (e.g., http://127.0.0.1:7890)"
        },
        "guigit.proxy.https": {
          "type": "string",
          "default": "",
          "description": "HTTPS proxy URL (e.g., http://127.0.0.1:7890)"
        },
        "guigit.proxy.noProxy": {
          "type": "string",
          "default": "",
          "description": "No proxy for these hosts (comma-separated)"
        },
        "guigit.autoStashOnPull": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "description": "Automatically stash uncommitted changes when pulling",
          "enumDescriptions": [
            "Ask each time what to do with uncommitted changes",
            "Always automatically stash uncommitted changes",
            "Never stash, cancel operation if there are uncommitted changes"
          ]
        },
        "guigit.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Git blame annotations in the editor"
        },
        "guigit.blame.showOnlyCurrentLine": {
          "type": "boolean",
          "default": true,
          "description": "Show Git blame annotations only for the current editor line"
        },
        "guigit.blame.format": {
          "type": "string",
          "default": "${author}: ${summary}",
          "description": "Git blame annotation format"
        },
        "guigit.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh",
            "es",
            "fr",
            "de",
            "ja",
            "ru"
          ],
          "default": "auto",
          "description": "Language preference for GUI Git History extension",
          "enumDescriptions": [
            "Follow VS Code UI language",
            "English",
            "中文",
            "Español",
            "Français",
            "Deutsch",
            "日本語",
            "Русский"
          ]
        },
        "guigit.fileViewMode": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "default": "tree",
          "description": "Default file change view mode in commit details"
        },
        "guigit.ai.provider": {
          "type": "string",
          "enum": [
            "vscodeLanguageModel",
            "openAICompatible"
          ],
          "default": "openAICompatible",
          "description": "AI provider used to generate commit messages"
        },
        "guigit.ai.commitMessagePrompt.mode": {
          "type": "string",
          "enum": [
            "default",
            "custom"
          ],
          "default": "default",
          "description": "Prompt rule mode used when generating commit messages",
          "enumDescriptions": [
            "Use the built-in conventional commit message rules",
            "Use custom prompt rules configured by the user"
          ]
        },
        "guigit.ai.commitMessagePrompt.customRules": {
          "type": "string",
          "default": "",
          "description": "Custom prompt rules used when commit message prompt mode is custom"
        },
        "guigit.ai.openAICompatible.protocol": {
          "type": "string",
          "enum": [
            "chatCompletions",
            "responses",
            "claudeMessages"
          ],
          "default": "chatCompletions",
          "description": "HTTP AI API protocol used to generate commit messages",
          "enumDescriptions": [
            "OpenAI-compatible Chat Completions API",
            "OpenAI Responses API",
            "Anthropic Claude Messages API"
          ]
        },
        "guigit.ai.openAICompatible.baseUrl": {
          "type": "string",
          "default": "",
          "description": "API host for the HTTP AI provider, without endpoint path"
        },
        "guigit.ai.openAICompatible.model": {
          "type": "string",
          "default": "",
          "description": "Model name for the OpenAI-compatible provider"
        },
        "guigit.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug",
            "off"
          ],
          "default": "info",
          "description": "Logging level for GUI Git History diagnostics",
          "enumDescriptions": [
            "Only log errors",
            "Log important lifecycle and operation messages",
            "Log detailed RPC and Git diagnostics",
            "Disable extension logging"
          ]
        }
      }
    },
    "commands": [
      {
        "command": "guigit.showHistory",
        "title": "Show Git History",
        "icon": "$(git-branch)"
      },
      {
        "command": "guigit.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "guigit.toggleBlame",
        "title": "Toggle Git Blame",
        "icon": "$(eye)"
      },
      {
        "command": "guigit.viewFileHistory",
        "title": "View File History",
        "icon": "$(history)"
      },
      {
        "command": "guigit.showCommitDetails",
        "title": "Show Commit Details"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "guigit",
          "title": "Git History",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "guigit": [
        {
          "type": "webview",
          "id": "guigit.historyView",
          "name": "Commit History"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "guigit.refresh",
          "when": "view == guigit.historyView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "guigit.viewFileHistory",
          "when": "resourceScheme == file",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "guigit.viewFileHistory",
          "when": "editorTextFocus && !isInDiffEditor",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eslint": "eslint src --ext .ts",
    "lint": "pnpm run eslint",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json && node scripts/bundle-extension-host.mjs",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.38",
    "simple-git": "^3.29.0",
    "undici": "^5.29.0",
    "vscode-nls-i18n": "^0.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.6.3",
    "esbuild": "^0.27.7",
    "vitest": "^4.0.15"
  }
}
